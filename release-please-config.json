{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "release-type": "simple",
  "packages": {
    ".": {
      "component": "gubexplorer",
      "changelog-path": "CHANGELOG.md",
      "bump-minor-pre-major": true,
      "extra-files": [
        {
          "type": "yaml",
          "path": "charts/gubexplorer/Chart.yaml",
          "jsonpath": "$.version"
        },
        {
          "type": "yaml",
          "path": "charts/gubexplorer/Chart.yaml",
          "jsonpath": "$.appVersion"
        }
      ]
    }
  }
}
